MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1389133071}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: '!!'
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: I think one of the keys I carried fell off.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: Oh...?
    cutsceneImage: {fileID: 21300000, guid: 6193b7e34a8b6624686e55d606edea40, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: The key... broke?
    cutsceneImage: {fileID: 21300000, guid: 6193b7e34a8b6624686e55d606edea40, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: Or maybe...
    cutsceneImage: {fileID: 21300000, guid: 6193b7e34a8b6624686e55d606edea40, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: I then checked each of the keys I was carrying.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: Just as I thought, all of the colored tips turned out to be removable.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: But why...?
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: '!!'
    cutsceneImage: {fileID: -5895795991965008814, guid: 251e04c764ee44b4fa4f073599c3f6c7, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: So that means...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: ...
    cutsceneImage: {fileID: 21300000, guid: 098f9939563dbb04c814c9c43fa318cf, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1447365486}
          m_TargetAssemblyTypeName: GameManager, Assembly-CSharp
          m_MethodName: GetSecondFloorFinalKey
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    disableTextSpecificDelays: 1
  - sentence: This should unlock that elongated lock.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  isInteractable: 0
