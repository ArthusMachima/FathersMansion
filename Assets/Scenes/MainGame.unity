--- !u!114 &510617031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510617029}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: Wait... let me read into that newspaper a little more
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: Let's see here...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: '"Authorities are still on a lookout for five missing people"'
    cutsceneImage: {fileID: 2136133903, guid: 0fe83cc2907d912438f879a894543623, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: '"According to investigators, the last known location of each individual
      is near a forest with a mansion nearby."'
    cutsceneImage: {fileID: 2136133903, guid: 0fe83cc2907d912438f879a894543623, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: '"There have been talks of authorities planning to seek a search warrant
      for the mansion."'
    cutsceneImage: {fileID: 2136133903, guid: 0fe83cc2907d912438f879a894543623, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: ...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: missing people... forest...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: '!'
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: Am I perhaps...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: One of the missing people...?
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
  - sentence: Maybe they're searching for me right now?
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  isInteractable: 0
  isRepeatable: 0
  onlyShownOnce: 1
  isCutscene: 1
  isPuzzleDialogue: 0
