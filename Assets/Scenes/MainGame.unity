--- !u!114 &1642866728
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1642866724}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: 'I found a magazine lying here that reads:'
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: "\u201DA look at the evolution of the Dial Telephone\u201D"
    cutsceneImage: {fileID: 21300000, guid: 3578548ef6bb1554188c1800d2aa6eb8, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: "\u201DThe Model 50AL Candlestick was introduced in 1919 as the first
      free-standing dial telephone.\u201D"
    cutsceneImage: {fileID: 21300000, guid: 3578548ef6bb1554188c1800d2aa6eb8, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: "\u201CThis groundbreaking model kicked off the rotary dial era that
      dominated the rest of the 20th century.\u201D"
    cutsceneImage: {fileID: 21300000, guid: 3578548ef6bb1554188c1800d2aa6eb8, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: "\u201CIn 1927, Western Electric produced the Model A1, their first
      telephone featuring a convenie-\u201D Okay I don\u2019t think this could help
      my situation."
    cutsceneImage: {fileID: 21300000, guid: 3578548ef6bb1554188c1800d2aa6eb8, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  isInteractable: 1
  isRepeatable: 0
  onlyShownOnce: 0
  isCutscene: 0
  isPuzzleDialogue: 0
