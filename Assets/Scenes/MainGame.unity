  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: There's a piece of paper lying on the table.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: 'It says the following:'
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: '"To whom who may concern, the only way out of your predicament is
      to take the time to know your surroundings like a friend."'
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
  - sentence: I think it's telling me to check every object in a room.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
