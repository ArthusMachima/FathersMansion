  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: These pile of boxes are blocking my path.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: I could move these one by one if I could, although they're too heavy
      for me.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: or... I could just go there from the other side of the door.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
