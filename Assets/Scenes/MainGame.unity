--- !u!114 &397217992
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397217987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: Let's see, we have...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: A paper clip, could use it to make lock picks.
    cutsceneImage: {fileID: -3294014016939171930, guid: ac4d2cdae92a5fd4ca26f04f363d822a, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: And...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: ...
    cutsceneImage: {fileID: -1123473351, guid: f27cb743b88a0fe42be121a6396b9728, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: Wait, this is...
    cutsceneImage: {fileID: -1123473351, guid: f27cb743b88a0fe42be121a6396b9728, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: A painting of a younger me... why is it here?
    cutsceneImage: {fileID: -1123473351, guid: f27cb743b88a0fe42be121a6396b9728, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: What is the meaning of this?
    cutsceneImage: {fileID: -1123473351, guid: f27cb743b88a0fe42be121a6396b9728, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: Does this mean I used to live here? Like perhaps this was my auntie's
      place or something?
    cutsceneImage: {fileID: -1123473351, guid: f27cb743b88a0fe42be121a6396b9728, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: I can't think hard about this now, I have to focus finding a way out.
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 0
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: 
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 397217991}
