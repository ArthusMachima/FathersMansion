  m_GameObject: {fileID: 408528391}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: ...
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: '"Jon bought five apples, he gave it to Kimberly."'
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: '"Kimberly ate two and gave one to Joana, from which, out of gratitude,
      she exchanged five oranges in return."'
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: '"Joana was disapointed to find out that one of her oranges had spoiled."'
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: '"Now, how many fresh fruit does Kimberly currently have?"'
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: Is this some kind of riddle?
    cutsceneImage: {fileID: 21300000, guid: 48d72ac4a947b7741ad1305cc3615d81, type: 3}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: I'll take this just in case...
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: 
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
