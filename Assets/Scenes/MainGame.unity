    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: But why...?
    cutsceneImage: {fileID: 0}
    sound: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
    disableTextSpecificDelays: 1
    willBeInterupted: 0
    noFadeInTransition: 0
  - sentence: '!!'
