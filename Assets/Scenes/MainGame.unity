MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1051024846}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cbc5addb558b0f46ab5a62838de0dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - sentence: Oi!
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Who you lookin at me for?
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Never seen a blue person before?
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: '"uhm... no..?"'
    cutsceneImage: {fileID: 21300000, guid: 3e1564ad89e56c74186686353a4e998c, type: 3}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: You offend me.
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: By the way, there should be a matching puzzle here somewhere behind
      me.
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: And a painting puzzle at my left side.
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Goodluck!
    cutsceneImage: {fileID: 0}
    methodCall:
      m_PersistentCalls:
        m_Calls: []
  isInteractable: 1
  isCutscene: 0
  isRepeatable: 0
  onlyShownOnce: 0
